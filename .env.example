DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
APP_URL=http://localhost:3000
# Supabase: use the TRANSACTION POOLER string (port 6543) on Vercel. For `npm run db:migrate` use the direct or session string (port 5432).
# Optional: DATABASE_SSL_CA with the Supabase root certificate PEM (use \n for line breaks) to verify the server certificate.
SEED_DEMO=true
SHOW_DEMO_LOGINS=true
STORAGE_DIR=.storage

# Document storage on Vercel (Supabase Storage). Server-only secrets: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=member-documents
CRON_SECRET=change-me

# SMS (Africa's Talking) - leave empty to keep notifications in "simulated" mode
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# MTN Mobile Money (sandbox or production)
MTN_MOMO_ENV=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=

# Airtel Money
AIRTEL_ENV=sandbox
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
